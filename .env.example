# Copy to .env for local development. Production values live only on the VPS.

# Postgres connection. Local: `npm run db:up` starts it (docker-compose.yml).
DATABASE_URL=postgres://wm:wm-dev-only@127.0.0.1:5544/wm
# Database the tests use; they empty it before each test.
TEST_DATABASE_URL=postgres://wm:wm-dev-only@127.0.0.1:5544/wm_test

# Where the API listens. Production sits behind a reverse proxy that terminates TLS.
HOST=127.0.0.1
PORT=3100

# Outgoing email (codes for password reset and email verification), as an SMTP URL: smtps://user:pass@host:465 or smtp://user:pass@host:587.
# Local: a Mailtrap sandbox inbox. Production: the provider the owner confirms (Resend works over SMTP).
SMTP_URL=
# The sender people see.
MAIL_FROM="What Matters <no-reply@example.com>"

# Token lifetimes, and how long an emailed code lasts (password reset and email verification).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESET_CODE_MINUTES=15

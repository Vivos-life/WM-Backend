# Copy to .env for local development. Production values live only on the VPS.

# Postgres connection. Local: `npm run db:up` starts it (docker-compose.yml).
DATABASE_URL=postgres://wm:wm-dev-only@127.0.0.1:5544/wm
# Database the tests use; they empty it before each test.
TEST_DATABASE_URL=postgres://wm:wm-dev-only@127.0.0.1:5544/wm_test

# Where the API listens. Production sits behind a reverse proxy that terminates TLS.
HOST=127.0.0.1
PORT=3100

# Outgoing email (codes for password reset and email verification), over SMTP.
# Local: a Mailtrap sandbox inbox (Mailtrap › Email Testing › your inbox › SMTP settings show these four).
# Production: the provider the owner confirms (Resend works over SMTP).
SMTP_HOST=sandbox.smtp.mailtrap.io
# 587 or 2525 upgrade to TLS (STARTTLS, required); 465 is TLS from the start.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender people see.
MAIL_FROM="What Matters <no-reply@example.com>"

# Token lifetimes, and how long an emailed code lasts (password reset and email verification).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESET_CODE_MINUTES=15

# People's own photos: a private Cloudflare R2 bucket. In Cloudflare › R2: the account ID, and an R2 API token with
# Object Read & Write on this bucket only (its Access Key ID and Secret Access Key). R2 encrypts every stored object
# (AES-256-GCM, keys held by Cloudflare) with nothing to switch on; see developers.cloudflare.com/r2/reference/data-security.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=what-matters-bucket
# The bucket's jurisdiction, if it was made in one (Cloudflare shows "| EU" beside it): eu. Empty for the default.
R2_JURISDICTION=eu
